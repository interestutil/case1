<Window x:Class="case1.Employee"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:case1"
        ResizeMode="NoResize"
        mc:Ignorable="d"
        Title="Employee" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="110"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <Label HorizontalAlignment="Center" Name="emp_name_label" FontWeight="Bold" FontSize="35" Margin="0, 10, 0, 0" Content="test"></Label>
        <Label Width="200" Height="40" Name="pendinglabel" FontSize="20" Margin="-400, 70, 0, 0" Content="Pending / In progress" Background="LightGray"></Label>

        <!--row 0-->

        <DataGrid Grid.Row="1" AlternatingRowBackground="DarkGray" Name="pendingdata"></DataGrid>
    </Grid>
</Window>
