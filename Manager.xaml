<Window x:Class="case1.Manager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:case1"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="Manager" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="120"></RowDefinition>
        </Grid.RowDefinitions>

        <Label Content="Task Id: " FontSize="20" VerticalAlignment="Center" Margin="20"></Label>
        <TextBox Name="taskidtextbox" FontSize="20" VerticalAlignment="Center" Margin="-400,0,0,0" Width="200"></TextBox>
        <Label Content="Status: " FontSize="20" VerticalAlignment="Center" Margin="400, 0, 0, 0"></Label>
        <ComboBox Name="statuscombo" Width="130" Height="30" Margin="300, 0, 0, 0">
            <ComboBoxItem Content="In Progress"></ComboBoxItem>
            <ComboBoxItem Content="Completed"></ComboBoxItem>
            <ComboBoxItem Content="Pending"></ComboBoxItem>
        </ComboBox>
        
        <!--row 0-->

        <Label Grid.Row="1" Content="Title: " FontSize="20" VerticalAlignment="Center" Margin="20"></Label>
        <TextBox Grid.Row="1" Name="titletextbox" FontSize="20" VerticalAlignment="Center" Margin="-400,0,0,0" Width="200"></TextBox>
        <Label Grid.Row="1" Content="Employee Name: " FontSize="20" VerticalAlignment="Center" Margin="400, 0, 0, 0"></Label>
        <TextBox Grid.Row="1" Name="nametextbox" FontSize="20" VerticalAlignment="Center" Margin="550, 0, 0, 0" Width="200"></TextBox>
    
        <!--row 1-->

        <Label Grid.Row="2" Content="Description: " FontSize="20" VerticalAlignment="Center" Margin="20"></Label>
        <TextBox Grid.Row="2" Name="descriptiontextbox" FontSize="20" VerticalAlignment="Center" Margin="-300,0,0,0" Width="200"></TextBox>
    
        <!--row 2-->

        <Button Grid.Row="3" Content="Add" Width="120" Height="30" Margin="-300,10,0,0" Click="Button_Click"></Button>
        <Button Grid.Row="3" Content="Edit" Width="120" Height="30" Margin="0,10,0,0" Click="Button_Click_1" ></Button>
        <Button Grid.Row="3" Content="Delete" Width="120" Height="30" Margin="300,10,0,0" Click="Button_Click_2" ></Button>

        <!--row 3-->

        <DataGrid AutoGenerateColumns="False" SelectionMode="Single" IsReadOnly="True" Grid.Row="4" AlternatingRowBackground="DarkGray" Name="managerdata">
            <DataGrid.Columns>
                <DataGridTextColumn Header="EmployeeName" Binding="{Binding Name}"></DataGridTextColumn>
                <DataGridTextColumn Header="TaskID" Binding="{Binding TaskID}"></DataGridTextColumn>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}"></DataGridTextColumn>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}"></DataGridTextColumn>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}"></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
